FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 280.72941;

boundaryField
{
    sym1
    {
        type            wedge;
    }
    sym2
    {
        type            wedge;
    }
    axis
    {
        type            zeroGradient;
    }
    inlet
    {
        type            turbulentMixingLengthFrequencyInlet;
        mixingLength    0.00062;
        value           uniform 280.72941;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 280.72941;
        value           uniform 280.72941;
    }
    membrane
    {
        type            omegaWallFunction;
        value           uniform 280.72941;
    }
    wall1
    {
        type            omegaWallFunction;
        value           uniform 280.72941;
    }
}


