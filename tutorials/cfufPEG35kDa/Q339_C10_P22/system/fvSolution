FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// PIMPLE: 1 outer corrector, 3 pressure correctors, 2 non-orthogonal
// correctors.

solvers
{
    // p_rgh: tolerance 1e-12 only in the final solve of the time step
    // (p_rghFinal); the intermediate correctors use 1e-9 with relTol 0.01.
    p_rgh
    {
        solver          GAMG;
        smoother        DIC;
        tolerance       1e-9;
        relTol          0.01;
        maxIter         50;
    }

    p_rghFinal
    {
        $p_rgh;
        tolerance       1e-12;
        relTol          0;
    }

    "(U|CA|k|omega)"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-10;
        relTol          0.01;
        maxIter         100;
    }

    "(U|CA|k|omega)Final"
    {
        $U;
        relTol          0;
    }
}

PIMPLE
{
    momentumPredictor          no;
    // Non-orthogonal correctors (checkMesh: maximum non-orthogonality 70.6 deg)
    nNonOrthogonalCorrectors   2;
    nCorrectors                3;
    nOuterCorrectors           1;
    pMax                       100e5;
    pMin                       0;
}

relaxationFactors
{
    fields
    {
        p_rgh   0.3;
    }
    equations
    {
        U       0.8;
        k       0.5;
        omega   0.5;
        CA      0.8;
        "(CA)Final" 1.0;
    }
}

