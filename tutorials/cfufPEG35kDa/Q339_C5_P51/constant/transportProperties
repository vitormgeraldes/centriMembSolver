// Concentration-dependent viscosity nu(CA) (library libCAViscosity)
transportModel  CAViscosity;

// Solute properties: CAViscosityCoeffs, diffusivity, density, virialCoeffs, massTransfer
#include "../constant/speciesData/PEG35000"

// Passive tracer diffusivity [m2/s] (used only when solveTracer is true)
DT0  2.5e-10;

