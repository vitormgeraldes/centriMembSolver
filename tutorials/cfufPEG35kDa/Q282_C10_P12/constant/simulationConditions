// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Case Q282_C10_P12: radial cross-flow ultrafiltration cell (CFUF), PEG 35 kDa
//   feed flow rate Q = 2.82 L/min, C0 = 10 kg/m3, TMP = 1.2 bar
// Jv and Robs are the values measured in the experimental run Q282_C10_P12
// (Jv = 21.61 L/(m2 h), observed rejection 97.82 %).
// Uin = Q/A0, A0 = pi*D0^2/4, D0 = 6.2 mm (inlet diameter).
//
// Between the 36 cases only this file, 0/CA, 0/U, 0/k, 0/omega and the
// lower limit of the CA scheme in system/fvSchemes (= C0) differ.

// Solute; its properties are in constant/speciesData/PEG35000, included by
// constant/transportProperties
solute      PEG35000;

// Operating conditions. Of this file only rRef, RPM and Pref are read
// (constant/rRef, constant/SRFProperties, constant/pRef); 0/U and 0/CA
// contain the same values of Uin, Jv, Robs and CA0 as literals.
Uin         1.5567705;    // [m/s]   mean inlet velocity, Q/A0
Jv          6.002778e-06; // [m/s]   mean permeate flux (JvAverage in 0/U)
Robs        0.9782;       // [-]     observed rejection (Robs in 0/CA)
CA0         10;           // [kg/m3] feed concentration

// Passive tracer (not used: solveTracer false in system/controlDict)
RTobs       1.0;
CT0         0.001;

// Rotating frame: not used, the CFUF cell does not rotate (RPM = 0)
rRef        0;
RPM         0;
Pref        120000;       // [Pa]    nominal transmembrane pressure (1.2 bar)

// ************************************************************************* //
