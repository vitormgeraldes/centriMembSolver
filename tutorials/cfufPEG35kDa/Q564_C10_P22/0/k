FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.036353017;

boundaryField
{
    sym1
    {
        type            wedge;
    }
    sym2
    {
        type            wedge;
    }
    axis
    {
        type            zeroGradient;
    }
    inlet
    {
        type            turbulentIntensityKineticEnergyInlet;
        intensity       0.05;
        value           uniform 0.036353017;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0.036353017;
        value           uniform 0.036353017;
    }
    membrane
    {
        type            kLowReWallFunction;
        value           uniform 1e-12;
    }
    wall1
    {
        type            kLowReWallFunction;
        value           uniform 0.036353017;
    }
}


