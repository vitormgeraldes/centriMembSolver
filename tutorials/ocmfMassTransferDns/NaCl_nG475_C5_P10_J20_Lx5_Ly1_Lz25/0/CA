FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      CA;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
#include "./constant/simulationConditions"
dimensions      [1 -3 0 0 0 0 0];

internalField   uniform $CA0;

boundaryField
{
    membrane
    {
        type            membraneSoluteFlux;
        model           observedRejection;
        Robs            $Robs;
        UName           U;
        computeGama     yes;
        CAb             $CA0;
        value           uniform 0;
    }
    inlet
    {
        // Open top (v1.2.1): fluid leaves and re-enters with its local
        // concentration. inletOutlet (re-entry at CA0) loses 1-7 % of the
        // retained solute through the recirculating plumes.
        type            zeroGradient;
    }
    yMinus
    {
        type            cyclic;
    }
    yPlus
    {
        type            cyclic;
    }
    zMinus
    {
        type            cyclic;
    }
    zPlus
    {
        type            cyclic;
    }
}


