FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    membrane
    {
        type            fixedFluxPressure;
        value           $internalField;
    }
    inlet
    {
        // Open top (v1.2.1): only the MEAN of p_rgh is fixed; the distribution is
        // extrapolated from the interior, so the hydrostatic pressure signature of
        // the plumes (p_rgh' = -beta*gh*CA') is not clamped and the eddies cross
        // the boundary instead of being reflected (a fixedValue p_rgh reflects them).
        type            fixedMean;
        meanValue       0;
        value           uniform 0;
    }
    yMinus
    {
        type            cyclic;
    }
    yPlus
    {
        type            cyclic;
    }
    zMinus
    {
        type            cyclic;
    }
    zPlus
    {
        type            cyclic;
    }
}


