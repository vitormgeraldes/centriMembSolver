FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Number of MPI ranks used for the published run of this case. It can be
// changed: a different decomposition changes the results only at round-off
// level.
numberOfSubdomains 30;
method scotch;

simpleCoeffs
{
    n               (3 1 1);
    delta           0.001;
}

preservePatches ( yMinus yPlus zMinus zPlus );

distributed     no;

roots
(
