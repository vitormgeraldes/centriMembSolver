FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p_rgh
    {
        solver                 GAMG;
        tolerance              1e-8;
        relTol                 0.05;
        smoother               DICGaussSeidel;
        cacheAgglomeration     true;
        agglomerator           faceAreaPair;
        mergeLevels            1;

        nCellsInCoarsestLevel  100;
        nFinestLevel           2;
        nSmoothPre             2;
        nSmoothPost            2;
        maxIter                15;
    }

    p_rghFinal
    {
        $p_rgh;
        relTol          0;
        maxIter         50;
    }

    U
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-9;
        relTol          0.05;
    }

    UFinal
    {
        $U;
        tolerance       1e-9;
        relTol          0;
    }

    CA
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.05;
    }
    CT
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-8;
        relTol          0.05;
    }
    CAFinal
    {
        $CA;
        relTol          0;
    }
    CTFinal
    {
        $CA;
        relTol          0;
    }
}

PIMPLE
{
    momentumPredictor no;
    nNonOrthogonalCorrectors 0;
    nCorrectors       1;
    nOuterCorrectors  2;
    pMax 100e5;
    pMin 0;
}

relaxationFactors
{
    fields
    {
        p_rgh 1.0;
    }
    equations
    {
        "(U|CA|CT)"       1.0;
    }
}


